{
  "name": "learningfans",
  "version": "0.1.0",
  "private": true,
  "description": "LearningFans — your study community on every device",
  "author": {
    "name": "imredavid64-glitch",
    "email": "imredavid64@users.noreply.github.com"
  },
  "homepage": "https://learningfans.vercel.app",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:sync": "next build && npx cap copy",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "mobile:ios:build": "npx cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Release -archivePath ios/App.xcarchive archive && xcodebuild -exportArchive -archivePath ios/App.xcarchive -exportPath ios/App.ipa -exportOptionsPlist ios/exportOptions.plist",
    "mobile:gen-icons": "node scripts/gen-icons.mjs",
    "mobile:android:apk": "cd android && ./gradlew assembleRelease",
    "mobile:android:bundle": "cd android && ./gradlew bundleRelease",
    "desktop:start": "electron desktop/main.js",
    "desktop:build": "electron-builder --config desktop/electron-builder.yml",
    "desktop:build:mac": "electron-builder --config desktop/electron-builder.yml --mac",
    "desktop:build:win": "electron-builder --config desktop/electron-builder.yml --win",
    "desktop:build:linux": "electron-builder --config desktop/electron-builder.yml --linux",
    "desktop:copy": "node scripts/copy-downloads.mjs",
    "downloads:build": "npm run mobile:android:apk && npm run desktop:build && node scripts/copy-downloads.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
