# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xhximqrchwwwwwsysgdo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL for auth redirects
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel production (set in Vercel dashboard, not here):
# NEXT_PUBLIC_APP_URL=https://learningfans.vercel.app

# Study Hub integration (server-only)
STUDY_HUB_PROJECT=nnrdkdisjfudibvrggxb
STUDY_HUB_SERVICE_KEY=your_study_hub_service_role_key

# AI moderation + meeting reminders via Groq (server-only, optional)
# Without GROQ_API_KEY, moderation falls back to the local profanity filter
# and meeting reminders use plain-text fallbacks.
GROQ_API_KEY=

# AI security analysis for school admins (server-only, optional)
# Used by /app/admin — school provisioning still works without it.
GEMINI_API_KEY=

# Supabase management API token — school provisioning (server-only, optional)
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Archival to a second Supabase project (server-only, optional)
# When the main DB nears its size limit, old data is archived here.
ARCHIVE_SUPABASE_URL=
ARCHIVE_SUPABASE_SERVICE_KEY=

# Web push notifications (VAPID — works on PWA/browsers, no Firebase needed)
# Generate keys with: npx web-push generate-vapid-keys
# The PUBLIC key ships to the browser; the PRIVATE key is server-only.
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects the /api/push/send cron endpoint — name it exactly CRON_SECRET so
# Vercel adds `Authorization: Bearer $CRON_SECRET` to cron requests (any random string)
CRON_SECRET=
